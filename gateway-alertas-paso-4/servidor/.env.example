# El sistema sigue en modo de prueba. No cambiar estas dos líneas.
APP_MODE=test
SMS_ENABLED=false

# Puede pegar el ID o la URL completa de su Google Sheets.
GOOGLE_SHEETS_ID=PEGAR_AQUI_EL_ID_O_LA_URL

# Cambie DESTINATARIOS si su pestaña tiene otro nombre.
GOOGLE_SHEETS_RANGE=DESTINATARIOS!A1:I
SHEETS_SYNC_SECONDS=15

# Ruta relativa al proyecto.
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service-account.json

# Base de datos local creada automáticamente.
DATABASE_PATH=data/alerts.db

# Los destinatarios se obtienen de la base sincronizada, sin límite fijo de tres.
